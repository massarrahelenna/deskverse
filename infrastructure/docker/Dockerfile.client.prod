# Build context: project root (needed for shared/ alongside client/)
# Usage: docker build -f infrastructure/docker/Dockerfile.client.prod -t deskverse-client .

FROM node:22-alpine AS builder
WORKDIR /app

# shared types must be available before npm install resolves @shared/* paths
COPY shared ./shared/
COPY client/package*.json ./client/
RUN cd client && npm ci
COPY client ./client/
RUN cd client && npm run build
# output: /app/client/dist

FROM nginx:alpine
COPY --from=builder /app/client/dist /usr/share/nginx/html
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
